---
import { NAV, SITE } from "../data/site";
import { SERVICES } from "../data/services";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

function current(href: string) {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(`${href}/`);
}
---

<a class="skip" href="#main">Skip to content</a>
<div class="util">
  <div class="wrap util-inner">
    <p>
      Open 24 hours · Call / text
      <a href={SITE.tel}>{SITE.phoneDisplay}</a>
    </p>
    <p class="util-right">LGBTQ+ friendly · Local to Bedfordshire</p>
  </div>
</div>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="logo" href="/" aria-label="Devine Plumbing and Heating, home">
      <svg class="logo-mark" viewBox="0 0 48 48" aria-hidden="true">
        <rect width="48" height="48" rx="10" fill="#17233a"></rect>
        <path d="M12 14h10a7 7 0 0 1 0 14H18v8" fill="none" stroke="#2ec4d4" stroke-width="3" stroke-linecap="round"></path>
        <path d="M26 36h12" fill="none" stroke="#2ec4d4" stroke-width="3" stroke-linecap="round"></path>
      </svg>
      <span>
        <span class="logo-name">Devine</span>
        <span class="logo-sub">Plumbing & heating</span>
      </span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      Menu
    </button>
    <nav class="nav" id="site-nav" aria-label="Main">
      {
        NAV.map((item) =>
          item.href === "/services" ? (
            <div class="drop">
              <a href={item.href} aria-current={current(item.href) ? "page" : undefined}>
                {item.label}
              </a>
              <div class="drop-menu">
                {SERVICES.map((service) => (
                  <a href={`/services/${service.slug}`}>{service.menu}</a>
                ))}
              </div>
            </div>
          ) : (
            <a href={item.href} aria-current={current(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ),
        )
      }
    </nav>
    <div class="header-cta">
      <a class="header-phone" href={SITE.tel}>
        <span>Call / text</span>
        <strong>{SITE.phoneDisplay}</strong>
      </a>
      <a class="btn" href="/contact">Get a quote</a>
    </div>
  </div>
</header>
<script>
  const button = document.querySelector(".nav-toggle");
  const nav = document.querySelector("#site-nav");
  button?.addEventListener("click", () => {
    const open = nav?.classList.toggle("open");
    button.setAttribute("aria-expanded", open ? "true" : "false");
    button.textContent = open ? "Close" : "Menu";
  });
</script>
