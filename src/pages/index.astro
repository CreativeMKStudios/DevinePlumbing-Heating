---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { SITE } from "../data/site";
import { SERVICES } from "../data/services";
import { REVIEWS, REVIEW_TOPICS } from "../data/reviews";
import { AREAS } from "../data/areas";
import { PROJECTS } from "../data/projects";
import hero from "../assets/gas-fire.jpg";

const faqs = [
  {
    q: "Are you really open all night?",
    a: "The Google profile says open 24 hours, seven days. Nick’s review describes a Friday evening call-out for a flood. For a smell of gas, leave and call 0800 111 999 first.",
  },
  {
    q: "Where do you cover?",
    a: "The firm’s own words on Google are that it is local to Bedfordshire. The map pin is near Edenham in South Kesteven, Lincolnshire. There is no published shop address. Call with your postcode.",
  },
  {
    q: "Do you fit boilers?",
    a: "Yes. The Google card lists boiler repair and boiler installation. Laura described a new combi boiler. James described a new valve on a boiler.",
  },
  {
    q: "How do I book?",
    a: `Call or text ${SITE.phoneDisplay}. Say your town, what has failed, and whether water is still running. There is no public email on the Google profile.`,
  },
];

const extraSchema = [
  {
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
];
---

<Base
  title="Plumber in Bedfordshire, open 24 hours"
  description="Darren at Devine Plumbing and Heating. Local to Bedfordshire, open 24 hours. Leaks, boilers and gas fires. Call or text 07436 135412."
  includeReviews
  extraSchema={extraSchema}
>
  <section class="hero">
    <Image
      src={hero}
      alt="Gas fire fitted by Devine Plumbing and Heating, photographed on the Google profile"
      widths={[640, 960, 1200]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-img"
    />
    <div class="hero-shade"></div>
    <div class="wrap">
      <div class="hero-copy">
        <p class="eyebrow">Plumber · Open 24 hours</p>
        <h1>When things break, we turn up</h1>
        <p>
          Devine Plumbing and Heating. Darren works on leaks, boilers, heating and the jobs customers
          actually wrote about. Call or text {SITE.phoneDisplay}.
        </p>
        <a class="pill" href="/contact">
          Book a service
          <span class="pill-arrow" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path d="M4 9h10M10 5l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="facts" aria-label="Key facts">
    <div class="wrap facts">
      <div>
        <strong>5.0 from 13</strong>
        <span>Google reviews</span>
      </div>
      <div>
        <strong>24 hours</strong>
        <span>Every day, as listed</span>
      </div>
      <div>
        <strong>Gas Safe</strong>
        <span>Stated on the profile</span>
      </div>
      <div>
        <strong>{SITE.phoneDisplay}</strong>
        <span>Call or text Darren</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <h2>A plumber you can ring</h2>
        <p>
          The Google description is short and clear: reliable plumbing and heating, local to
          Bedfordshire. Customers talk about Darren by name. They mention a combi boiler, a gas fire,
          a leaking tundish, bathroom taps, a dishwasher, a shower pump and a stopcock.
        </p>
        <p>
          There is no shop to walk into. The map pin sits near Edenham, on the Lincolnshire side of
          the border, close to Bourne. Do not drive there. Call or text, say the town, and Darren
          comes to the house.
        </p>
        <p>
          <a href="/about">Read about the firm</a> · <a href="/reviews">Read the Google reviews</a>
        </p>
      </div>
      <div class="panel">
        <h3>What people mention</h3>
        <ul class="topics">
          {REVIEW_TOPICS.map((topic) => <li>{topic.label} · {topic.count}</li>)}
        </ul>
        <p class="muted" style="margin-top:1rem">
          Topic counts are the ones Google shows on the profile. The score is 5.0 across all 13 reviews.
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <h2>Work we actually do</h2>
      <p class="muted">Taken from the Google profile card and from the reviews, not from a generic list.</p>
      <div class="card-grid">
        {
          SERVICES.map((service) => (
            <article class="card">
              <h3>{service.title}</h3>
              <p>{service.summary}</p>
              <p>
                <a href={`/services/${service.slug}`}>See this service</a>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <h2>Recent words from Google</h2>
      <div class="review-grid">
        {
          REVIEWS.slice(0, 3).map((review) => (
            <article class="review">
              <header>
                <div>
                  <div class="who">{review.name}</div>
                  <div class="muted">{review.dateLabel} · {review.meta}</div>
                </div>
                <div class="stars" aria-label="5 out of 5">★★★★★</div>
              </header>
              <p>{review.text.split("\n")[0]}</p>
            </article>
          ))
        }
      </div>
      <p><a href="/reviews">All quoted reviews, and the link to the other eight</a></p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap split">
      <div>
        <h2>Jobs customers described</h2>
        <p>
          {PROJECTS[0].detail}
        </p>
        <p>
          <a href="/projects">See the other jobs</a>
        </p>
      </div>
      <figure class="media">
        <Image
          src={hero}
          alt="Chrome gas fire with a floral tiled surround, from the Google profile"
          widths={[480, 720, 960]}
          sizes="(max-width: 720px) 100vw, 50vw"
        />
        <figcaption class="caption">
          Gas fire photo from the Google profile. {PROJECTS[0].customer}, {PROJECTS[0].date}.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <h2>Towns to ask about</h2>
      <p class="muted">
        Bedfordshire is what the profile says. Bourne, Stamford and Edenham are the towns around the pin.
        Call to confirm the street.
      </p>
      <div class="area-grid">
        {
          AREAS.filter((area) =>
            ["bedford", "luton", "bourne", "stamford", "edenham", "leighton-buzzard"].includes(area.slug),
          ).map((area) => (
            <article class="area-card">
              <h3>{area.name}</h3>
              <p class="muted">{area.county}</p>
              <p>{area.paragraphs[0]}</p>
              <p>
                <a href={`/areas/${area.slug}`}>Plumber in {area.name}</a>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap prose">
      <h2>Straight answers</h2>
      {
        faqs.map((faq) => (
          <div>
            <h3>{faq.q}</h3>
            <p>{faq.a}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div>
        <h2>Need someone today?</h2>
        <p>Call or text {SITE.phoneDisplay}. If water is running, say so first.</p>
      </div>
      <a class="btn light" href={SITE.tel}>Call {SITE.phoneDisplay}</a>
    </div>
  </section>
</Base>
