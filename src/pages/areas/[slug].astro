---
import Base from "../../layouts/Base.astro";
import { AREAS, getArea } from "../../data/areas";
import { SERVICES } from "../../data/services";
import { SITE } from "../../data/site";

export function getStaticPaths() {
  return AREAS.map((area) => ({ params: { slug: area.slug } }));
}

const area = getArea(Astro.params.slug ?? "");
if (!area) throw new Error("Missing area");

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Areas", path: "/areas" },
  { name: area.name, path: `/areas/${area.slug}` },
];

const extraSchema = [
  {
    "@type": "Service",
    name: `Plumber in ${area.name}`,
    serviceType: "Plumbing and heating",
    provider: { "@id": new URL("/#business", Astro.site).href },
    areaServed: {
      "@type": "City",
      name: area.name,
      containedInPlace: { "@type": "AdministrativeArea", name: area.county },
    },
    url: new URL(`/areas/${area.slug}`, Astro.site).href,
    description: area.description,
  },
];
---

<Base title={`Plumber in ${area.name}`} description={area.description} crumbs={crumbs} extraSchema={extraSchema}>
  <div class="wrap page-hero prose wide">
    <p class="crumbs">
      <a href="/">Home</a> / <a href="/areas">Areas</a> / {area.name}
    </p>
    <h1>Plumber in {area.name}</h1>
    <p class="muted">{area.county}</p>
    {area.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <h2>Work people book</h2>
    <ul class="list">
      {
        SERVICES.slice(0, 5).map((service) => (
          <li>
            <a href={`/services/${service.slug}`}>{service.title}</a>. {service.summary}
          </li>
        ))
      }
    </ul>
    <p>
      <a class="btn" href={SITE.tel}>Call {SITE.phoneDisplay}</a>
    </p>
    <p>
      Nearby pages:
      {
        AREAS.filter((item) => item.slug !== area.slug)
          .slice(0, 4)
          .map((item, index) => (
            <>
              {index ? ", " : ""}
              <a href={`/areas/${item.slug}`}>{item.name}</a>
            </>
          ))
      }
    </p>
  </div>
</Base>
